PROFILE=deploy
ALLOWED_ORIGINS=https://tideo.vercel.app
SLEEP_LEASE_HOST=tideo-api.duckdns.org
SLEEP_LEASE_INTERVAL_SECONDS=60

REDIS_HOST=redis
POSTGRES_HOST=workspace-postgres
POSTGRES_PORT=5432
POSTGRES_USER=tideo_app
POSTGRES_PASSWORD=replace-with-the-provisioned-database-password
POSTGRES_DB=tideo_db
KAFKA_HOST=kafka
RABBITMQ_HOST=rabbitmq
RABBITMQ_DEFAULT_USER=tideo
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-password

DATA_DIR=/data
OUTPUT_TTL_DAYS=7
STORAGE_BUDGET_BYTES=53687091200
STORAGE_MIN_FREE_BYTES=1073741824
MAX_UPLOAD_BYTES=4294967296
MAX_SOURCE_SECONDS=7200
DEV_MAX_RENDITIONS=4
X264_PRESET=veryfast
STT_MODEL=base
LOG_LEVEL=INFO

TIDEO_HEAVY_CONCURRENCY=1
TIDEO_FAST_CONCURRENCY=2
TIDEO_TRANSCRIBE_CONCURRENCY=1
